# Variables de entorno (plantilla de ejemplo)
# Copia este archivo como .env y completa los valores, o configura
# las mismas variables en el panel de Vercel.

MAKE_AVAILABILITY_WEBHOOK_URL=https://hook.us2.make.com/xxxxx
MAKE_BOOKING_WEBHOOK_URL=https://hook.us2.make.com/xxxxx
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/TU_CLOUD_NAME/image/upload
CLOUDINARY_BASE_URL=https://res.cloudinary.com/TU_CLOUD_NAME/image/upload

# Apps Script (backend)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
VITE_APPS_SCRIPT_KEY=TU_API_KEY

# Cloudinary: configuración para upload desde el admin
VITE_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=daniela_gallery